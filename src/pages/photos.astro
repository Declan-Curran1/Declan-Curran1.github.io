---
import Page from '../layouts/Page.astro';
import { SITE_INSTAGRAM } from '../consts';

const sky = [
	{ src: '/media/photos/Koz_Comet_edited.jpg', alt: 'Comet over Mt Kosciuszko', caption: 'Comet C/2023 A3 (Tsuchinshan–ATLAS) over Mt Kosciuszko, NSW', wide: true },
	{ src: '/media/photos/Kosciuszko_Short.jpg', alt: 'Stars rising over the Kosciuszko ridge', caption: 'Kosciuszko, short exposure' },
	{ src: '/media/photos/Koz_Comet_Raw2.jpg', alt: 'The same comet in a single raw frame', caption: 'Same comet, single raw frame before stacking' },
	{ src: '/media/photos/IMG_0298_edited.jpg', alt: 'Milky Way over silhouetted gum trees', caption: 'Stars and gums', wide: true },
	{ src: '/media/photos/IMG_0640_ballina.jpg', alt: 'Night sky from Ballina', caption: 'Ballina, NSW' },
	{ src: '/media/photos/IMG_0645_ballina.jpg', alt: 'Night sky from Ballina', caption: 'Ballina, NSW' },
];

const tl = (name: string) => ({ src: `/media/timelapses/${name}.mp4`, poster: `/media/timelapses/${name}.jpg` });
const timelapses = [
	{ src: '/media/photos/timelapse.mp4', poster: '/media/photos/timelapse-poster.jpg', caption: 'Cloud and stars over a paddock, GoPro on the ground', ratio: '16 / 9', wide: true },
	{ ...tl('ger-tent-night-sky'), caption: 'Day into night over a ger tent, Mongolia', ratio: '9 / 16' },
	{ ...tl('khovsgol-nuur'), caption: 'Khövsgöl Nuur, Mongolia', ratio: '9 / 16' },
	{ ...tl('jackeys-marsh'), caption: 'Jackeys Marsh, Tasmania', ratio: '3 / 4' },
	{ ...tl('strahan'), caption: 'Strahan, Tasmania', ratio: '3 / 4' },
];

const road = [
	{ src: '/media/writing/spider.jpg', alt: 'A spider web across a car side mirror, with Declan reflected in it', caption: 'The spider in my sideview mirror', href: '/blog/to-the-spider-in-my-sideview-mirror/' },
	{ src: '/media/writing/agu-1.jpg', alt: 'Banksy-style street art of a girl with an umbrella on a New Orleans wall', caption: 'New Orleans, during AGU', href: '/blog/voodoo-mould-and-models/' },
	{ src: '/media/writing/liaoning-1.jpg', alt: 'Retired fighter jets and a radar dome in a park in Shenyang', caption: 'Old jets and a radar dome, Shenyang', href: '/blog/liaoning-province-and-masculinity/', wide: true },
	{ src: '/media/writing/liaoning-3.jpg', alt: 'A museum figure of a mounted Manchu warrior in layered armour', caption: 'Iron, feather and leather', href: '/blog/liaoning-province-and-masculinity/' },
	{ src: '/media/writing/liaoning-4.jpg', alt: 'View through a bus windscreen down a road lined with red flags towards misty mountains', caption: 'Liaoning, from the bus', href: '/blog/liaoning-province-and-masculinity/' },
];
---

<Page title="Photos · Declan Curran" description="Night-sky, landscape and travel photography by Declan Curran." image="/media/photos/Koz_Comet_edited.jpg">
	<header class="page-head">
		<span class="kicker">photos <span class="dot">·</span> mostly after dark</span>
		<h1>Photos</h1>
		<p class="question">What's still up there once your eyes adjust?</p>
		<p class="lede">
			Night skies from regional Australia, and pictures from the road that ended up in my writing. More on
			<a href={SITE_INSTAGRAM}>Instagram</a>.
		</p>
	</header>

	<section class="section">
		<div class="section-head">
			<span class="num">01</span>
			<h2>The night sky</h2>
		</div>
		<div class="grid">
			{
				sky.map((p) => (
					<figure class:list={{ wide: p.wide }}>
						<img src={p.src} alt={p.alt} loading="lazy" />
						<figcaption>{p.caption}</figcaption>
					</figure>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="section-head">
			<span class="num">02</span>
			<h2>Timelapses</h2>
		</div>
		<div class="grid tl">
			{
				timelapses.map((t) => (
					<figure class:list={{ wide: t.wide }}>
						<video controls preload="none" poster={t.poster} playsinline muted loop style={`aspect-ratio: ${t.ratio}`}>
							<source src={t.src} type="video/mp4" />
						</video>
						<figcaption>{t.caption}</figcaption>
					</figure>
				))
			}
		</div>
	</section>

	<section class="section">
		<div class="section-head">
			<span class="num">03</span>
			<h2>On the road</h2>
		</div>
		<div class="grid">
			{
				road.map((p) => (
					<figure class:list={{ wide: p.wide }}>
						<a href={p.href}>
							<img src={p.src} alt={p.alt} loading="lazy" />
						</a>
						<figcaption>
							{p.caption} · <a href={p.href}>read</a>
						</figcaption>
					</figure>
				))
			}
		</div>
	</section>
</Page>

<style>
	.page-head {
		padding-top: 3.2rem;
	}
	.grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.4rem 0.9rem;
	}
	.grid figure {
		margin: 0;
	}
	.grid .wide {
		grid-column: 1 / -1;
	}
	.grid img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}
	.grid .wide img {
		aspect-ratio: 16 / 9;
	}
	.grid a {
		display: block;
		overflow: hidden;
		border-radius: 3px;
	}
	figcaption a {
		display: inline !important;
		color: var(--muted);
	}
	video {
		width: 100%;
		object-fit: cover;
		display: block;
		background: #000;
		border-radius: 3px;
	}
	@media (max-width: 520px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.grid.tl {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
