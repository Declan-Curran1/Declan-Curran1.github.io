---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import Page from '../layouts/Page.astro';
import {
	KIND_LABEL,
	SITE_DESCRIPTION,
	SITE_EMAIL,
	SITE_GITHUB,
	SITE_INSTAGRAM,
	SITE_LINKEDIN,
	SITE_SUBSTACK,
	SITE_TAGLINE,
	SITE_TITLE,
} from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featured = posts.find((p) => p.data.featured);

const questions = [
	{
		label: 'Resolution',
		q: 'How much local detail can you recover from a coarse climate model?',
		a: 'Global models see the world in 25–100 km squares. I use hierarchical denoising to sharpen them to the scale of a catchment, a vineyard, or a single grid asset.',
	},
	{
		label: 'Physics',
		q: 'Can a sharper guess still respect the physics?',
		a: 'Fine-grained output is only useful if it stays consistent with the processes underneath it, so I check the residuals as closely as the prediction.',
	},
	{
		label: 'Decisions',
		q: 'Who actually acts on a forecast?',
		a: 'I like helping businesses solve problems with data, especially where climate, healthtech, economics and human behaviour overlap.',
	},
];

const photos = [
	{ src: '/media/photos/Koz_Comet_edited.jpg', alt: 'Comet Tsuchinshan–ATLAS over Mt Kosciuszko', cls: 'wide' },
	{ src: '/media/writing/spider.jpg', alt: 'A spider web across a car side mirror, with Declan reflected in it' },
	{ src: '/media/writing/agu-1.jpg', alt: 'Street art of a girl with an umbrella on a New Orleans wall', cls: 'tall' },
	{ src: '/media/photos/IMG_0298_edited.jpg', alt: 'The Milky Way above silhouetted gum trees' },
	{ src: '/media/writing/liaoning-4.jpg', alt: 'A road lined with red flags, seen through a bus windscreen in Liaoning' },
	{ src: '/media/photos/IMG_0645_ballina.jpg', alt: 'Night sky over Ballina, NSW' },
];

const [user, domain] = SITE_EMAIL.split('@');
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<img class="portrait" src="/media/portrait.jpg" alt="Declan in a beanie, looking up into the trees" width="160" height="160" />
		<div>
			<span class="kicker">climate <span class="dot">·</span> data <span class="dot">·</span> words <span class="dot">·</span> night skies</span>
			<h1>Declan Curran</h1>
		</div>
	</section>
	<p class="question">{SITE_TAGLINE}</p>
	<p class="lede">
		I'm finishing a research Master's in Computer Science on <a href="/work/">climate downscaling</a>, which means
		turning coarse climate models into forecasts you can plan around. The rest of the time I write
		<a href="/blog/">short stories, poems and travel essays</a> and wait up for comets.
	</p>

	<nav class="toc mono" aria-label="On this page">
		<a href="#writing">Writing</a>
		<a href="#research">Research</a>
		<a href="#photos">Photos</a>
		<a href="#hello">Say hello</a>
	</nav>

	{
		featured && (
			<a class="feature" href={`/blog/${featured.id}/`}>
				<div class="feature-img">
					<img src={featured.data.cover} alt={featured.data.coverAlt ?? ''} width="1600" height="1000" />
				</div>
				<div class="feature-text">
					<span class="kicker">
						a very short story <span class="dot">·</span> about coffee, sort of
					</span>
					<h2>{featured.data.title}</h2>
					<p>{featured.data.description}</p>
					<span class="more">Read it, about four minutes &rarr;</span>
				</div>
			</a>
		)
	}

	<section class="section" id="writing">
		<div class="section-head">
			<span class="num">01</span>
			<h2>Writing</h2>
		</div>
		<ol class="entries">
			{
				posts.map((p) => (
					<li>
						<div>
							<a href={`/blog/${p.id}/`}>{p.data.title}</a>
							<span class="meta">
								<span class="kind">{KIND_LABEL[p.data.kind]}</span> · <FormattedDate date={p.data.pubDate} />
							</span>
						</div>
					</li>
				))
			}
		</ol>
		<a class="more" href="/blog/">All writing &rarr;</a>
		&nbsp;&nbsp;
		<a class="more" href={SITE_SUBSTACK}>On Substack &rarr;</a>
	</section>

	<section class="section" id="research">
		<div class="section-head">
			<span class="num">02</span>
			<h2>Research</h2>
		</div>
		<ol class="questions">
			{
				questions.map((q, i) => (
					<li>
						<span class="kicker">
							{i + 1}. {q.label}
						</span>
						<h3>{q.q}</h3>
						<p>{q.a}</p>
					</li>
				))
			}
		</ol>
		<a class="more" href="/work/">The research, with videos &rarr;</a>
	</section>

	<section class="section" id="photos">
		<div class="section-head">
			<span class="num">03</span>
			<h2>Photos</h2>
		</div>
		<p>Mostly regional Australia after dark, plus whatever I pass on the way somewhere else.</p>
		<div class="mosaic">
			{
				photos.map((p) => (
					<a href="/photos/" class={p.cls}>
						<img src={p.src} alt={p.alt} loading="lazy" />
					</a>
				))
			}
		</div>
		<a class="more" href="/photos/">All photos and a timelapse &rarr;</a>
	</section>

	<section class="section" id="hello">
		<div class="section-head">
			<span class="num">04</span>
			<h2>Say hello</h2>
		</div>
		<p>
			If you're working on data, climate, healthtech or science, or you just want to swap a story idea or a
			dark-sky spot, write to me.
		</p>
		<ul class="hello mono">
			<li>
				<span>email</span>
				<a href={`mailto:${SITE_EMAIL}`}>{user} [at] {domain.replace('.', ' [dot] ')}</a>
			</li>
			<li><span>linkedin</span><a href={SITE_LINKEDIN}>in/declan-curran</a></li>
			<li><span>substack</span><a href={SITE_SUBSTACK}>@jacquessauvage</a></li>
			<li><span>github</span><a href={SITE_GITHUB}>Declan-Curran1</a></li>
			<li><span>instagram</span><a href={SITE_INSTAGRAM}>@declan_curran</a></li>
		</ul>
	</section>
</Page>

<style>
	.intro {
		display: flex;
		align-items: flex-end;
		gap: 1.2rem;
		padding-top: 3.5rem;
		margin-bottom: 0.4rem;
	}
	.intro h1 {
		margin: 0;
	}
	.portrait {
		width: 96px;
		height: 96px;
		object-fit: cover;
		object-position: 50% 20%;
		border-radius: 50%;
		flex: none;
		filter: saturate(0.9);
	}
	.toc {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 1.1rem;
		margin: 1.6rem 0 2.2rem;
	}
	.toc a {
		text-decoration: none;
		color: var(--muted);
	}
	.toc a::before {
		content: '↓ ';
		color: var(--accent);
	}
	.toc a:hover {
		color: var(--accent);
	}

	/* featured coffee story */
	.feature {
		display: block;
		text-decoration: none;
		color: inherit;
		background: var(--night);
		border-radius: 6px;
		overflow: hidden;
		margin: 0 -8px;
		box-shadow: 0 1px 0 rgb(0 0 0 / 0.04), 0 12px 32px -18px rgb(30 15 40 / 0.6);
	}
	.feature-img {
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}
	.feature-img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s ease;
	}
	.feature:hover .feature-img img {
		transform: scale(1.025);
	}
	.feature-text {
		padding: 1.2rem 1.4rem 1.4rem;
		color: #d9cfc1;
	}
	.feature-text .kicker {
		color: #a99e91;
	}
	.feature-text .dot {
		color: #f0a36b;
	}
	.feature-text h2 {
		color: #fbf4e8;
		font-size: 1.7rem;
		margin-bottom: 0.4rem;
	}
	.feature-text p {
		margin-bottom: 0.8rem;
		font-size: 1rem;
	}
	.feature .more {
		color: #f0a36b;
	}

	/* research */
	.questions {
		list-style: none;
		padding: 0;
		margin: 0 0 1rem;
	}
	.questions li {
		margin-bottom: 1.5rem;
	}
	.questions h3 {
		font-size: 1.18rem;
		margin-bottom: 0.3rem;
	}
	.questions p {
		margin: 0;
		color: var(--muted);
		font-size: 1rem;
	}

	/* photos */
	.mosaic {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		grid-auto-rows: 140px;
		gap: 6px;
		margin: 0 0 1rem;
	}
	.mosaic a {
		overflow: hidden;
		border-radius: 3px;
		background: var(--paper-2);
	}
	.mosaic .wide {
		grid-column: span 2;
		grid-row: span 2;
	}
	.mosaic .tall {
		grid-row: span 2;
	}
	.mosaic img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}
	.mosaic a:hover img {
		transform: scale(1.04);
	}

	/* hello */
	.hello {
		list-style: none;
		padding: 0;
		margin: 0;
		font-size: 0.82rem;
	}
	.hello li {
		display: grid;
		grid-template-columns: 6.5rem 1fr;
		padding: 0.25rem 0;
	}
	.hello span {
		color: var(--muted);
	}

	@media (max-width: 640px) {
		.intro {
			padding-top: 2.4rem;
		}
		.portrait {
			width: 72px;
			height: 72px;
		}
		.feature {
			margin: 0;
		}
		.mosaic {
			grid-template-columns: repeat(2, 1fr);
			grid-auto-rows: 120px;
		}
		.mosaic .tall {
			grid-row: span 2;
		}
	}
</style>
