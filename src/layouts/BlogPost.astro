---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { KIND_LABEL } from '../consts';
import Page from './Page.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, kind, cover, coverAlt, substack } = Astro.props;
const isStory = kind === 'story';
const ogImage = cover && !cover.endsWith('.svg') ? cover : undefined;
---

<Page title={`${title} · Declan Curran`} description={description} image={ogImage}>
	<article class:list={['post', `kind-${kind}`]}>
		<header class="post-head">
			<span class="kicker">
				<a href="/blog/">writing</a> <span class="dot">·</span> {KIND_LABEL[kind]?.toLowerCase()}
				<span class="dot">·</span> <FormattedDate date={pubDate} />
			</span>
			<h1>{title}</h1>
			<p class="question">{description}</p>
			{
				updatedDate && (
					<p class="mono">
						Updated <FormattedDate date={updatedDate} />
					</p>
				)
			}
		</header>

		{
			cover && (
				<figure class:list={['cover', { night: isStory }]}>
					<img src={cover} alt={coverAlt ?? ''} />
				</figure>
			)
		}

		<div class="prose">
			<slot />
		</div>

		<footer class="post-foot mono">
			{substack && <a href={substack}>Also on Substack &rarr;</a>}
			<a href="/blog/">&larr; All writing</a>
		</footer>
	</article>
</Page>

<style>
	.post-head {
		padding-top: 3.2rem;
	}
	.post-head h1 {
		font-size: clamp(2rem, 6vw, 2.9rem);
		margin-bottom: 0.7rem;
	}
	.post-head .question {
		font-size: 1.15rem;
		margin-bottom: 0.6rem;
	}
	.kicker a {
		color: inherit;
		text-decoration: none;
	}
	.kicker a:hover {
		color: var(--accent);
	}
	.cover {
		margin: 1.8rem 0 2.2rem;
	}
	.cover.night {
		margin-left: -8px;
		margin-right: -8px;
	}
	.cover.night img {
		border-radius: 6px;
		background: var(--night);
	}
	.prose {
		font-size: 1.06rem;
		line-height: 1.75;
	}
	.prose :global(p) {
		margin: 0 0 1.25em;
	}
	.prose :global(h2) {
		margin: 2rem 0 0.8rem;
		font-size: 1.35rem;
	}
	.prose :global(img) {
		margin: 2rem 0;
	}
	.prose :global(em) {
		color: var(--muted);
	}

	/* stories get a drop cap */
	.kind-story .prose > :global(p:first-of-type)::first-letter {
		float: left;
		font-size: 3.6em;
		line-height: 0.85;
		padding: 0.08em 0.1em 0 0;
		color: var(--accent);
	}

	/* poems: keep line breaks, set as stanzas */
	.kind-poem .prose {
		font-size: 1.15rem;
		line-height: 1.6;
		padding-left: 0.2rem;
	}
	.kind-poem .prose :global(p) {
		white-space: pre-line;
		margin-bottom: 1.4em;
	}
	.kind-poem .prose :global(p:last-child) {
		font-style: italic;
		color: var(--ink);
	}

	.post-foot {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.6rem;
		margin-top: 3rem;
		padding-top: 1rem;
		border-top: 1px solid var(--rule);
	}
	.post-foot a {
		color: var(--muted);
		text-decoration: none;
	}
	.post-foot a:hover {
		color: var(--accent);
	}
	@media (max-width: 640px) {
		.cover.night {
			margin-left: 0;
			margin-right: 0;
		}
	}
</style>
