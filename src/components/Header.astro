---
import { SITE_TITLE } from '../consts';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
	{ href: '/work/', label: 'Research', match: '/work' },
	{ href: '/blog/', label: 'Writing', match: '/blog' },
	{ href: '/photos/', label: 'Photos', match: '/photos' },
	{ href: '/about/', label: 'About', match: '/about' },
];
---

<a class="skip" href="#content">Skip to the contents</a>
<header class="site-header">
	<nav aria-label="Main">
		<a class="brand" href="/">{SITE_TITLE}</a>
		<ul>
			{
				links.map((l) => (
					<li>
						<a href={l.href} aria-current={path.startsWith(l.match) ? 'page' : undefined}>
							{l.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	.site-header {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 1.4rem 20px 0;
		box-sizing: border-box;
	}
	nav {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.4rem 1.2rem;
	}
	.brand {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		text-decoration: none;
		color: var(--ink);
		letter-spacing: 0.02em;
	}
	ul {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.05rem;
		margin: 0;
		padding: 0;
	}
	ul a {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		text-decoration: none;
		color: var(--muted);
	}
	ul a:hover,
	ul a[aria-current='page'] {
		color: var(--accent);
	}
	@media (max-width: 640px) {
		.site-header {
			padding: 1.1rem 16px 0;
		}
	}
</style>
