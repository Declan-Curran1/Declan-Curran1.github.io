---
import { SITE_AUTHOR, SITE_GITHUB, SITE_LINKEDIN, SITE_SUBSTACK } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<p class="links mono">
		<a href={SITE_SUBSTACK}>Substack</a>
		<a href={SITE_LINKEDIN}>LinkedIn</a>
		<a href={SITE_GITHUB}>GitHub</a>
		<a href="/rss.xml">RSS</a>
	</p>
	<p class="mono">
		&copy; {year} {SITE_AUTHOR}. Brewed slowly, mostly after dark.
		<a href="#top">Back to the top &uarr;</a>
	</p>
</footer>

<style>
	.site-footer {
		max-width: var(--measure);
		margin: 4rem auto 0;
		padding: 1.4rem 20px 3rem;
		border-top: 1px solid var(--rule);
		box-sizing: border-box;
	}
	p {
		margin: 0 0 0.5rem;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1rem;
	}
	a {
		color: var(--muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
	@media (max-width: 640px) {
		.site-footer {
			padding: 1.2rem 16px 2.5rem;
		}
	}
</style>
