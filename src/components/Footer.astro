---
import { SITE_AUTHOR, SITE_EMAIL, SITE_GITHUB } from '../consts';
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p class="copy">&copy; {today.getFullYear()} {SITE_AUTHOR}</p>
		<div class="social-links">
			<a href={SITE_GITHUB} target="_blank" rel="noopener">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
			<a href={`mailto:${SITE_EMAIL}`}>
				<span class="sr-only">Email</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<rect x="3" y="5" width="18" height="14" rx="2"></rect>
					<path d="m3 7 9 6 9-6"></path>
				</svg>
			</a>
			<a href="/rss.xml">
				<span class="sr-only">RSS</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M4 11a9 9 0 0 1 9 9"></path>
					<path d="M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1"></circle>
				</svg>
			</a>
		</div>
	</div>
</footer>
<style>
	footer {
		padding: 3em 1em 4em;
		color: rgb(var(--gray));
		border-top: 1px solid rgb(var(--gray-light));
		margin-top: 4em;
	}
	.footer-inner {
		max-width: 720px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.copy {
		margin: 0;
		font-size: 0.9em;
	}
	.social-links {
		display: flex;
		gap: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
		display: inline-flex;
		transition: color 0.15s ease;
	}
	.social-links a:hover {
		color: var(--accent);
	}
</style>
